# Copy this file to .env.deploy.local and fill in your DreamHost details.
# .env.deploy.local matches the *.local pattern in .gitignore, so it is
# never committed -- safe to put real values in it.

# Your DreamHost shell username (Panel > Users > Manage Users).
DEPLOY_USER=

# The SSH host for your user. Your domain often works directly; if not,
# use the exact hostname shown on the Manage Users page for this user
# (looks like e.g. <server>.dreamhost.com).
DEPLOY_HOST=

# The folder DreamHost serves for your domain (Panel > Domains > Manage
# Domains shows the web directory). Usually ~/example.com, or
# ~/example.com/some-subfolder if you're deploying into a subdirectory.
DEPLOY_PATH=
